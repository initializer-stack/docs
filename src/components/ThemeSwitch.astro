---
// 색 모드: 시스템 · 라이트 · 다크. 고른 값은 localStorage 'theme' 에 두고 <html data-theme> 로 건다 (시스템은 속성을 지운다)
// 첫 화면 전에 되살리는 건 Base 의 head 스크립트
const choices = [
  { value: 'system', label: '시스템 설정', icon: 'M2 3h12v8H2zM6 14h4M8 11v3' },
  { value: 'light', label: '라이트', icon: 'M8 5a3 3 0 1 0 0 6 3 3 0 0 0 0-6zM8 1v1.5M8 13.5V15M1 8h1.5M13.5 8H15M3 3l1 1M12 12l1 1M3 13l1-1M12 4l1-1' },
  { value: 'dark', label: '다크', icon: 'M13.5 9.5A5.5 5.5 0 0 1 6.5 2.5a5.5 5.5 0 1 0 7 7z' },
]
---

<div class="theme" role="group" aria-label="색 모드">
  {
    choices.map(({ value, label, icon }) => (
      <button type="button" data-theme-choice={value} aria-label={label} title={label} aria-pressed="false">
        <svg viewBox="0 0 16 16" width="14" height="14" fill="none" stroke="currentColor" stroke-width="1.3" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
          <path d={icon} />
        </svg>
      </button>
    ))
  }
</div>

<script>
  const root = document.documentElement
  const mark = () => {
    const now = root.dataset.theme ?? 'system'
    for (const b of document.querySelectorAll<HTMLButtonElement>('[data-theme-choice]')) b.setAttribute('aria-pressed', String(b.dataset.themeChoice === now))
  }
  for (const b of document.querySelectorAll<HTMLButtonElement>('[data-theme-choice]')) {
    b.addEventListener('click', () => {
      const value = b.dataset.themeChoice!
      if (value === 'system') {
        delete root.dataset.theme
        localStorage.removeItem('theme')
      } else {
        root.dataset.theme = value
        localStorage.setItem('theme', value)
      }
      mark()
    })
  }
  mark()
</script>

<style>
  .theme {
    display: inline-flex;
    gap: 2px;
    padding: 2px;
    border: 1px solid var(--separator);
    border-radius: 999px;
  }
  button {
    display: grid;
    place-items: center;
    width: 24px;
    height: 24px;
    padding: 0;
    border: 0;
    border-radius: 999px;
    color: var(--tertiary-label);
    background: none;
    cursor: pointer;
  }
  button:hover {
    color: var(--label);
  }
  button[aria-pressed='true'] {
    color: var(--label);
    background: var(--secondary-background);
  }
</style>

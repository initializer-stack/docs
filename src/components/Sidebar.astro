---
// 지금 탭의 묶음 · 페이지 (src/sidebar.ts). 페이지는 세로 선 위에 두고, 지금 페이지는 선과 글자를 진하게
import { locate } from '../sidebar'

const here = Astro.url.pathname
const { tab } = locate(here)
---

<nav aria-label={tab.label}>
  {
    tab.groups.map((group) => (
      <section>
        <h2>{group.label}</h2>
        <ul>
          {group.items.map((item) => (
            <li>
              <a href={item.link} aria-current={item.link === here ? 'page' : undefined}>
                {item.label}
              </a>
            </li>
          ))}
        </ul>
      </section>
    ))
  }
</nav>

<style>
  section + section {
    margin-top: var(--space-8);
  }
  h2 {
    margin: 0 0 var(--space-3);
    font-size: var(--text-sm);
    font-weight: 500;
    color: var(--label);
  }
  ul {
    margin: 0;
    padding: 0;
    list-style: none;
    border-left: 1px solid var(--separator);
  }
  a {
    position: relative;
    display: block;
    margin-left: -1px;
    padding: 6px 0 6px var(--space-4);
    border-left: 1px solid transparent;
    font-size: var(--text-sm);
    line-height: 1.45;
    color: var(--secondary-label);
    text-decoration: none;
  }
  a:hover {
    color: var(--label);
    border-left-color: var(--tertiary-label);
  }
  a[aria-current] {
    color: var(--label);
    font-weight: 500;
    border-left-color: var(--label);
  }
</style>

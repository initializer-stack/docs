  /* 모션: 히어로는 열릴 때, 아래 블록(.reveal)은 화면에 들어올 때 한 번. 글은 자리에서 나타나기만 하고,
     그림은 연필로 그리듯 상자 → 선 → 글자 순서로 그린다(--d 만큼 늦게). 그리는 경로는 pathLength="1" 이라 대시 1 이 경로 전체다.
     아래 블록은 스크립트가 붙어야([data-motion]) 숨겼다 보여 준다: 스크립트가 없으면 그냥 보인다 */
  @media (prefers-reduced-motion: no-preference) {
    .hero-copy > *,
    [data-motion] .reveal {
      animation: landing-appear 0.6s ease-out var(--d, 0s) both;
    }
    .hero-copy > :nth-child(2) { --d: 0.1s; }
    .hero-copy > :nth-child(3) { --d: 0.2s; }
    .hero-copy > :nth-child(4) { --d: 0.3s; }
    .hero-copy > :nth-child(5) { --d: 0.4s; }
    .architecture { --d: 0.3s; }
    .feature:nth-child(2),
    .fit-copy,
    .start .actions { --d: 0.12s; }
    .feature:nth-child(3) { --d: 0.24s; }
    .mark::after {
      transform-origin: left;
      animation: landing-underline 0.6s cubic-bezier(0.6, 0, 0.3, 1) 0.6s both;
    }
    :is(.architecture, [data-motion] .reveal) :is(.boundary, .annotation) {
      animation: landing-appear 0.5s ease-out var(--d, 0s) both;
    }
    :is(.architecture, [data-motion] .reveal) .node {
      stroke-dasharray: 1;
      animation: landing-draw 0.9s ease-out var(--d, 0s) both;
    }
    :is(.architecture, [data-motion] .reveal) .wires {
      stroke-dasharray: 1;
      animation: landing-draw 0.8s ease-out calc(var(--d, 0s) + 0.5s) both;
    }
    /* 화살표 머리는 대시로 그려지지 않아 선보다 먼저 보인다: 화살표 선은 나타나기만 */
    :is(.architecture, [data-motion] .reveal) :is(.arrows, [marker-end]) {
      animation-name: landing-appear;
    }
    :is(.architecture, [data-motion] .reveal) :is(.diagram-text, .rule-line, figcaption) {
      animation: landing-appear 0.5s ease-out calc(var(--d, 0s) + 0.9s) both;
    }
    /* 오가는 점은 그림이 다 그려진 뒤에 */
    :is(.architecture, [data-motion] .reveal) .packets {
      animation: landing-appear 0.4s ease-out calc(var(--d, 0s) + 1.3s) both;
    }
    /* 검증 카드: 체크가 위에서부터 하나씩 (CI 가 차례로 통과시키듯) */
    [data-motion] .reveal .checks path {
      animation: landing-draw 0.35s ease-out calc(var(--d, 0s) + 1s + var(--i, 0) * 0.4s) both;
    }
    .checks path:nth-child(2) { --i: 1; }
    .checks path:nth-child(3) { --i: 2; }
    [data-motion] .reveal:not(.shown),
    [data-motion] .reveal:not(.shown) * {
      animation-play-state: paused !important;
    }
    /* 아래로 살펴보기 화살표는 살짝 까딱이고, 더 보기 화살표는 가리키면 앞으로 */
    .explore span {
      animation: landing-nudge 1.8s ease-in-out 1.5s infinite;
    }
    .more span {
      display: inline-block;
      transition: translate 150ms ease;
    }
    .more:is(:hover, :focus-visible) span {
      translate: 3px 0;
    }
  }
  @media (prefers-reduced-motion: reduce) {
    .packets,
    .glow {

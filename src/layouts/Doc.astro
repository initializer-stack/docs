---
// 문서 페이지의 틀: 왼쪽 사이드바(로고 · 색 모드 · 검색 · 지금 탭의 목차) · 위 탭 · 제목 칸 · 본문 · 이 페이지
// 1024px 아래에서는 사이드바가 서랍이 되고 위에 얇은 막대(로고 · 검색 · 메뉴)가 생긴다. 1280px 아래에서는 이 페이지를 숨긴다
import type { MarkdownHeading } from 'astro'
import Base from './Base.astro'
import Sidebar from '../components/Sidebar.astro'
import Toc from '../components/Toc.astro'
import Pagination from '../components/Pagination.astro'
import DocumentDiagrams from '../components/DocumentDiagrams.astro'
import ThemeSwitch from '../components/ThemeSwitch.astro'
import Search from '../components/Search.astro'
import { locate, tabs } from '../sidebar'
import '../styles/prose.css'

interface Props {
  title: string
  description?: string
  headings: MarkdownHeading[]
  editUrl: string
  /** 페이지 복사 버튼이 담는 마크다운 원문 */
  source: string
}
const { title, description, headings, editUrl, source } = Astro.props
const { tab, group } = locate(Astro.url.pathname)
// 페이지 메뉴: 이 페이지의 마크다운 원문([...slug].md.ts)과, 그 공개 주소를 읽게 하는 AI 대화
const markdown = `${Astro.url.pathname.replace(/\/$/, '')}.md`
const ask = encodeURIComponent(`이 문서를 읽고 내 질문에 답해 줘: ${new URL(markdown, Astro.site)}`)
const chatgpt = `https://chatgpt.com/?hints=search&q=${ask}`
const claude = `https://claude.ai/new?q=${ask}`
const tabIcons: Record<string, string> = {
  가이드: 'M3 2.5h7.5L13 5v8.5H3zM10.5 2.5V5H13M5.5 8h5M5.5 10.5h3.5',
  레퍼런스: 'M2.5 3h4a1.5 1.5 0 0 1 1.5 1.5V13a1.5 1.5 0 0 0-1.5-1.5h-4zM13.5 3h-4A1.5 1.5 0 0 0 8 4.5V13a1.5 1.5 0 0 1 1.5-1.5h4z',
  블로그: 'M10.5 2.5l3 3L6 13H3v-3zM9 4l3 3',
}
---

<Base title={title} description={description} header={false}>
  <DocumentDiagrams />
  <div class="shell">
    <aside class="sidebar" id="sidebar" aria-label="문서 탐색">
      <div class="brandrow">
        <a class="brand" href="/"><img src="/logo.svg" alt="" width="22" height="25" />iStack</a>
        <ThemeSwitch />
      </div>
      <button class="search" type="button" data-search-open>
        <svg viewBox="0 0 16 16" width="14" height="14" fill="none" stroke="currentColor" stroke-width="1.4" stroke-linecap="round" aria-hidden="true"><circle cx="7" cy="7" r="4.5"></circle><path d="M10.5 10.5 14 14"></path></svg>
        <span>검색…</span>
        <kbd>⌘K</kbd>
      </button>
      <div class="nav"><Sidebar /></div>
      <ul class="foot">
        <li><a href="https://github.com/initializer-stack/template">템플릿 저장소 <span aria-hidden="true">↗</span></a></li>
        <li><a href="https://github.com/initializer-stack/docs">가이드 저장소 <span aria-hidden="true">↗</span></a></li>
      </ul>
    </aside>
    <div class="backdrop" data-drawer-close></div>

    <div class="main">
      <div class="topbar">
        <a class="brand" href="/"><img src="/logo.svg" alt="" width="22" height="25" />iStack</a>
        <button class="icon" type="button" data-search-open aria-label="검색">
          <svg viewBox="0 0 16 16" width="18" height="18" fill="none" stroke="currentColor" stroke-width="1.4" stroke-linecap="round" aria-hidden="true"><circle cx="7" cy="7" r="4.5"></circle><path d="M10.5 10.5 14 14"></path></svg>
        </button>
        <button class="icon" type="button" data-drawer-open aria-controls="sidebar" aria-expanded="false" aria-label="메뉴">
          <svg viewBox="0 0 16 16" width="18" height="18" fill="none" stroke="currentColor" stroke-width="1.4" stroke-linecap="round" aria-hidden="true"><path d="M2.5 4.5h11M2.5 8h11M2.5 11.5h11"></path></svg>
        </button>
      </div>
      <nav class="tabs" aria-label="탭">
        {
          tabs.map((t) => (
            <a href={t.link} aria-current={t === tab ? 'page' : undefined}>
              <svg viewBox="0 0 16 16" width="15" height="15" fill="none" stroke="currentColor" stroke-width="1.3" stroke-linejoin="round" stroke-linecap="round" aria-hidden="true">
                <path d={tabIcons[t.label]} />
              </svg>
              {t.label}
            </a>
          ))
        }
      </nav>

      <div class="page">
        <article data-pagefind-body>
          <header class="head">
            {group && <p class="eyebrow">{group.label}</p>}
            <div class="titlerow">
              <h1>{title}</h1>
              <div class="actions" data-copy-source={source} data-pagefind-ignore>
                <button class="copy" type="button" data-copy>
                  <svg viewBox="0 0 16 16" width="14" height="14" fill="none" stroke="currentColor" stroke-width="1.3" stroke-linejoin="round" aria-hidden="true"><rect x="5" y="5" width="8.5" height="8.5" rx="1.5"></rect><path d="M3 10.5V3.5A1 1 0 0 1 4 2.5h6.5"></path></svg>
                  <span>페이지 복사</span>
                </button>
                <button class="more" type="button" popovertarget="page-menu" aria-label="페이지 메뉴">
                  <svg viewBox="0 0 16 16" width="14" height="14" fill="none" stroke="currentColor" stroke-width="1.4" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="m4 6 4 4 4-4"></path></svg>
                </button>
                <div class="menu" id="page-menu" popover>
                  <a href={markdown} target="_blank">
                    <svg viewBox="0 0 16 16" width="16" height="16" fill="none" stroke="currentColor" stroke-width="1.3" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><rect x="1.5" y="3.5" width="13" height="9" rx="1.5"></rect><path d="M4 10V6l2 2 2-2v4M11 6v4M9.5 8.5 11 10l1.5-1.5"></path></svg>
                    마크다운으로 보기 <svg class="out" viewBox="0 0 16 16" width="11" height="11" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M5 11 11 5M6 5h5v5"></path></svg>
                  </a>
                  <a href={chatgpt} target="_blank" rel="noopener">
                    <svg viewBox="0 0 24 24" width="16" height="16" fill="currentColor" aria-hidden="true"><path d="M22.2819 9.8211a5.9847 5.9847 0 0 0-.5157-4.9108 6.0462 6.0462 0 0 0-6.5098-2.9A6.0651 6.0651 0 0 0 4.9807 4.1818a5.9847 5.9847 0 0 0-3.9977 2.9 6.0462 6.0462 0 0 0 .7427 7.0966 5.98 5.98 0 0 0 .511 4.9107 6.051 6.051 0 0 0 6.5146 2.9001A5.9847 5.9847 0 0 0 13.2599 24a6.0557 6.0557 0 0 0 5.7718-4.2058 5.9894 5.9894 0 0 0 3.9977-2.9001 6.0557 6.0557 0 0 0-.7475-7.0729zm-9.022 12.6081a4.4755 4.4755 0 0 1-2.8764-1.0408l.1419-.0804 4.7783-2.7582a.7948.7948 0 0 0 .3927-.6813v-6.7369l2.02 1.1686a.071.071 0 0 1 .038.052v5.5826a4.504 4.504 0 0 1-4.4945 4.4944zm-9.6607-4.1254a4.4708 4.4708 0 0 1-.5346-3.0137l.142.0852 4.783 2.7582a.7712.7712 0 0 0 .7806 0l5.8428-3.3685v2.3324a.0804.0804 0 0 1-.0332.0615L9.74 19.9502a4.4992 4.4992 0 0 1-6.1408-1.6464zM2.3408 7.8956a4.485 4.485 0 0 1 2.3655-1.9728V11.6a.7664.7664 0 0 0 .3879.6765l5.8144 3.3543-2.0201 1.1685a.0757.0757 0 0 1-.071 0l-4.8303-2.7865A4.504 4.504 0 0 1 2.3408 7.872zm16.5963 3.8558L13.1038 8.364 15.1192 7.2a.0757.0757 0 0 1 .071 0l4.8303 2.7913a4.4944 4.4944 0 0 1-.6765 8.1042v-5.6772a.79.79 0 0 0-.407-.667zm2.0107-3.0231l-.142-.0852-4.7735-2.7818a.7759.7759 0 0 0-.7854 0L9.409 9.2297V6.8974a.0662.0662 0 0 1 .0284-.0615l4.8303-2.7866a4.4992 4.4992 0 0 1 6.6802 4.66zM8.3065 12.863l-2.02-1.1638a.0804.0804 0 0 1-.038-.0567V6.0742a4.4992 4.4992 0 0 1 7.3757-3.4537l-.142.0805L8.704 5.459a.7948.7948 0 0 0-.3927.6813zm1.0976-2.3654l2.602-1.4998 2.6069 1.4998v2.9994l-2.5974 1.4997-2.6067-1.4997Z"></path></svg>
                    ChatGPT 에서 열기 <svg class="out" viewBox="0 0 16 16" width="11" height="11" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M5 11 11 5M6 5h5v5"></path></svg>
                  </a>
                  <a href={claude} target="_blank" rel="noopener">
                    <svg viewBox="0 0 24 24" width="16" height="16" fill="currentColor" aria-hidden="true"><path d="m4.7144 15.9555 4.7174-2.6471.079-.2307-.079-.1275h-.2307l-.7893-.0486-2.6956-.0729-2.3375-.0971-2.2646-.1214-.5707-.1215-.5343-.7042.0546-.3522.4797-.3218.686.0608 1.5179.1032 2.2767.1578 1.6514.0972 2.4468.255h.3886l.0546-.1579-.1336-.0971-.1032-.0972L6.973 9.8356l-2.55-1.6879-1.3356-.9714-.7225-.4918-.3643-.4614-.1578-1.0078.6557-.7225.8803.0607.2246.0607.8925.686 1.9064 1.4754 2.4893 1.8336.3643.3035.1457-.1032.0182-.0728-.164-.2733-1.3539-2.4467-1.445-2.4893-.6435-1.032-.17-.6194c-.0607-.255-.1032-.4674-.1032-.7285L6.287.1335 6.6997 0l.9957.1336.419.3642.6192 1.4147 1.0018 2.2282 1.5543 3.0296.4553.8985.2429.8318.091.255h.1579v-.1457l.1275-1.706.2368-2.0947.2307-2.6957.0789-.7589.3764-.9107.7468-.4918.5828.2793.4797.686-.0668.4433-.2853 1.8517-.5586 2.9021-.3643 1.9429h.2125l.2429-.2429.9835-1.3053 1.6514-2.0643.7286-.8196.85-.9046.5464-.4311h1.0321l.759 1.1293-.34 1.1657-1.0625 1.3478-.8804 1.1414-1.2628 1.7-.7893 1.36.0729.1093.1882-.0183 2.8535-.607 1.5421-.2794 1.8396-.3157.8318.3886.091.3946-.3278.8075-1.967.4857-2.3072.4614-3.4364.8136-.0425.0304.0486.0607 1.5482.1457.6618.0364h1.621l3.0175.2247.7892.522.4736.6376-.079.4857-1.2142.6193-1.6393-.3886-3.825-.9107-1.3113-.3279h-.1822v.1093l1.0929 1.0686 2.0035 1.8092 2.5075 2.3314.1275.5768-.3218.4554-.34-.0486-2.2039-1.6575-.85-.7468-1.9246-1.621h-.1275v.17l.4432.6496 2.3436 3.5214.1214 1.0807-.17.3521-.6071.2125-.6679-.1214-1.3721-1.9246L14.38 17.959l-1.1414-1.9428-.1397.079-.674 7.2552-.3156.3703-.7286.2793-.6071-.4614-.3218-.7468.3218-1.4753.3886-1.9246.3157-1.53.2853-1.9004.17-.6314-.0121-.0425-.1397.0182-1.4328 1.9672-2.1796 2.9446-1.7243 1.8456-.4128.164-.7164-.3704.0667-.6618.4008-.5889 2.386-3.0357 1.4389-1.882.929-1.0868-.0062-.1579h-.0546l-6.3385 4.1164-1.1293.1457-.4857-.4554.0608-.7467.2307-.2429 1.9064-1.3114Z"></path></svg>
                    Claude 에서 열기 <svg class="out" viewBox="0 0 16 16" width="11" height="11" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M5 11 11 5M6 5h5v5"></path></svg>
                  </a>
                </div>
              </div>
            </div>
            {description && <p class="desc">{description}</p>}
          </header>
          <div class="prose"><slot /></div>
          <div data-pagefind-ignore>
            <a class="edit" href={editUrl}>GitHub 에서 고치기</a>
            <Pagination />
          </div>
        </article>
        <aside class="toc"><Toc headings={headings} /></aside>
      </div>
    </div>
  </div>
  <Search />
</Base>

<script>
  // 페이지 복사 (제목 옆 버튼 · 메뉴): 마크다운 원문을 클립보드로. 메뉴는 고르면 닫는다
  const actions = document.querySelector<HTMLElement>('[data-copy-source]')!
  const pageMenu = actions.querySelector<HTMLElement>('[popover]')!
  const copied = actions.querySelector('.copy span')!
  const closeMenu = () => pageMenu.matches(':popover-open') && pageMenu.hidePopover()
  for (const button of actions.querySelectorAll('[data-copy]'))
    button.addEventListener('click', async () => {
      await navigator.clipboard.writeText(actions.dataset.copySource!)
      closeMenu()
      copied.textContent = '복사됨'
      setTimeout(() => (copied.textContent = '페이지 복사'), 1500)
    })
  pageMenu.addEventListener('click', (e) => (e.target as Element).closest('a') && closeMenu())

  // 좁은 화면의 서랍 (메뉴 버튼 · 배경 · Esc · 링크를 누르면 닫는다)
  const root = document.documentElement
  const menu = document.querySelector<HTMLButtonElement>('[data-drawer-open]')!
  const setOpen = (open: boolean) => {
    if (open) root.dataset.drawer = 'open'
    else delete root.dataset.drawer
    menu.setAttribute('aria-expanded', String(open))
  }
  menu.addEventListener('click', () => setOpen(root.dataset.drawer !== 'open'))
  document.querySelector('[data-drawer-close]')!.addEventListener('click', () => setOpen(false))
  document.querySelector('#sidebar')!.addEventListener('click', (e) => (e.target as Element).closest('a') && setOpen(false))
  addEventListener('keydown', (e) => e.key === 'Escape' && setOpen(false))
</script>

<style>
  .shell {
    /* 제목으로 건너뛸 때 위에 붙는 막대 높이 (탭) */
    --header-height: 49px;
  }
  a {
    color: inherit;
    text-decoration: none;
  }
  .brand {
    display: flex;
    align-items: center;
    gap: var(--space-2);
    font-weight: 600;
    font-size: 1.0625rem;
    letter-spacing: -0.01em;
  }

  /* 사이드바 */
  .sidebar {
    position: fixed;
    inset: 0 auto 0 0;
    z-index: 30;
    display: flex;
    flex-direction: column;
    width: var(--width-sidebar);
    padding: var(--space-6) var(--space-6) 0;
    border-right: 1px solid var(--separator);
    background: var(--background);
  }
  .brandrow {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: var(--space-3);
  }
  .search {
    display: flex;
    align-items: center;
    gap: var(--space-2);
    width: 100%;
    height: 38px;
    margin-top: var(--space-6);
    padding: 0 var(--space-3);
    border: 1px solid var(--separator);
    border-radius: 10px;
    font: inherit;
    font-size: var(--text-sm);
    color: var(--secondary-label);
    background: none;
    cursor: pointer;
  }
  .search:hover {
    border-color: var(--secondary-label);
  }
  .search span {
    flex: 1;
    text-align: left;
  }
  kbd {
    font-family: var(--font);
    font-size: var(--text-xs);
    color: var(--tertiary-label);
  }
  .nav {
    flex: 1;
    min-height: 0;
    margin: var(--space-8) calc(-1 * var(--space-6)) 0;
    padding: 0 var(--space-6) var(--space-8);
    overflow-y: auto;
  }
  .foot {
    margin: 0 calc(-1 * var(--space-6));
    padding: var(--space-3) var(--space-6);
    border-top: 1px solid var(--separator);
    list-style: none;
    font-size: var(--text-sm);
  }
  .foot a {
    display: flex;
    justify-content: space-between;
    padding: 6px 0;
    color: var(--secondary-label);
  }
  .foot a:hover {
    color: var(--label);
  }

  /* 오른쪽: 탭 · 페이지 */
  .main {
    margin-left: var(--width-sidebar);
  }
  .topbar {
    display: none;
  }
  .tabs {
    position: sticky;
    top: 0;
    z-index: 10;
    display: flex;
    /* 밑줄이 글자보다 양옆으로 --space-2 길게: 탭에 준 안쪽 여백만큼 간격 · 바깥 여백을 줄여 글자 자리는 그대로 */
    gap: calc(var(--space-8) - 2 * var(--space-2));
    height: 48px;
    padding: 0 calc(var(--space-16) - var(--space-2));
    border-bottom: 1px solid var(--separator);
    background: color-mix(in srgb, var(--background) 85%, transparent);
    backdrop-filter: saturate(180%) blur(20px);
  }
  .tabs a {
    display: flex;
    align-items: center;
    gap: 6px;
    margin-bottom: -1px;
    padding: 0 var(--space-2);
    border-bottom: 2px solid transparent;
    font-size: var(--text-sm);
    font-weight: 500;
    color: var(--secondary-label);
    white-space: nowrap;
  }
  /* 아이콘 그림은 16 칸 상자 안에서 왼쪽이 2px 쯤 비어 있다: 밑줄이 그림보다 왼쪽으로만 삐져나오지 않게 당긴다 */
  .tabs a svg {
    margin-left: -2px;
  }
  .tabs a:hover {
    color: var(--label);
  }
  .tabs a[aria-current] {
    color: var(--label);
    border-bottom-color: var(--label);
  }

  .page {
    display: grid;
    grid-template-columns: minmax(0, var(--width-prose)) var(--width-toc);
    justify-content: center;
    gap: var(--space-16);
    padding: var(--space-12) var(--space-16) var(--space-24);
  }
  .head {
    margin-bottom: var(--space-8);
  }
  .eyebrow {
    margin: 0 0 var(--space-2);
    font-size: var(--text-sm);
    font-weight: 600;
    color: var(--label);
  }
  .titlerow {
    display: flex;
    align-items: flex-start;
    justify-content: space-between;
    gap: var(--space-6);
  }
  h1 {
    margin: 0;
    font-size: 2.25rem;
    line-height: 1.15;
    font-weight: 600;
    letter-spacing: -0.025em;
    word-break: keep-all;
  }
  .desc {
    margin: var(--space-3) 0 0;
    font-size: 1.125rem;
    line-height: 1.6;
    color: var(--secondary-label);
    word-break: keep-all;
  }
  .actions {
    display: inline-flex;
    flex: none;
    margin-top: 4px;
    border: 1px solid var(--separator);
    border-radius: 10px;
    anchor-name: --page-menu;
  }
  .actions > button {
    display: inline-flex;
    align-items: center;
    gap: 6px;
    height: 32px;
    padding: 0 var(--space-3);
    border: 0;
    font: inherit;
    font-size: var(--text-sm);
    color: var(--label);
    background: none;
    cursor: pointer;
  }
  .actions > button:hover {
    background: var(--secondary-background);
  }
  .actions > .copy {
    border-radius: 9px 0 0 9px;
  }
  .actions > .more {
    padding: 0 var(--space-2);
    border-left: 1px solid var(--separator);
    border-radius: 0 9px 9px 0;
  }
  .menu {
    width: 232px;
    padding: var(--space-1);
    border: 1px solid var(--separator);
    border-radius: var(--radius);
    color: var(--label);
    background: var(--grouped-item);
    box-shadow: 0 12px 32px rgb(0 0 0 / 0.12);
  }
  /* 버튼 아래 오른쪽 끝에 맞춘다. anchor 를 모르는 브라우저는 popover 기본값(화면 가운데) */
  @supports (anchor-name: --a) {
    .menu {
      position-anchor: --page-menu;
      inset: auto;
      top: anchor(bottom);
      right: anchor(right);
      margin: 6px 0 0;
    }
  }
  .menu a {
    display: flex;
    gap: 10px;
    align-items: center;
    padding: var(--space-2) 10px;
    border-radius: 8px;
    font-size: var(--text-sm);
    color: inherit;
    text-decoration: none;
  }
  .menu a:hover,
  .menu a:focus-visible {
    background: var(--secondary-background);
  }
  .menu svg {
    flex: none;
    color: var(--secondary-label);
  }
  .menu .out {
    margin-left: auto;
    color: var(--tertiary-label);
  }
  .edit {
    display: inline-block;
    margin-top: var(--space-12);
    font-size: var(--text-sm);
    color: var(--secondary-label);
  }
  .edit:hover {
    color: var(--label);
  }
  .toc {
    position: sticky;
    top: calc(48px + var(--space-12));
    align-self: start;
    max-height: calc(100vh - 48px - var(--space-16));
    overflow-y: auto;
  }
  .backdrop {
    display: none;
  }

  @media (max-width: 1280px) {
    .page {

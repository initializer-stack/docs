---
// 모든 페이지의 껍데기: head · 머리글 · 전역 기본 스타일. 문서 페이지는 자기 틀(사이드바 · 탭)이 있어 머리글을 끈다 (header={false})
import '../styles/tokens.css'
import Header from '../components/Header.astro'

interface Props {
  title?: string
  description?: string
  header?: boolean
}
const { header = true } = Astro.props
const site = 'iStack'
const description = Astro.props.description ?? '여러 언어의 서버 · 클라이언트를 계약 하나로 잇는 모노레포 템플릿'
const title = Astro.props.title ? `${Astro.props.title} · ${site}` : site
---

<!doctype html>
<html lang="ko">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="color-scheme" content="light dark" />
    <!-- 고른 색 모드를 첫 화면 전에 (ThemeSwitch) -->
    <script is:inline>
      const theme = localStorage.getItem('theme')
      if (theme === 'light' || theme === 'dark') document.documentElement.dataset.theme = theme
    </script>
    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="canonical" href={new URL(Astro.url.pathname, Astro.site)} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:image" content={new URL('/banner.png', Astro.site)} />
    <meta property="og:image:width" content="1280" />
    <meta property="og:image:height" content="640" />
    <meta property="og:image:alt" content="iStack — 모눈 종이 위에 연필로 그린 보라 · 청록 · 호박색 스택과 손글씨 워드마크" />
    <meta name="twitter:card" content="summary_large_image" />
    <slot name="head" />
  </head>
  <body>
    {header && <Header />}
    <slot />
  </body>
</html>

<style is:global>
  *,
  *::before,
  *::after {
    box-sizing: border-box;
  }
  body {
    margin: 0;
    font-family: var(--font);
    font-size: var(--text-base);
    color: var(--label);
    background: var(--background);
    -webkit-font-smoothing: antialiased;
  }
  img,
  svg {
    display: block;
    max-width: 100%;
  }
  :focus-visible {
    outline: 2px solid var(--accent);
    outline-offset: 2px;
  }
  /* 스크롤바: 얇은 연필색 손잡이, 길은 투명 (종이 바탕에 흰 띠가 생기지 않게). 사이드바 · 코드 같은 안쪽 스크롤도 같다 */
  * {
    scrollbar-width: thin;
    scrollbar-color: var(--scrollbar-thumb) transparent;
  }
  /* scrollbar-color 를 모르는 브라우저(예전 Safari)는 webkit 스크롤바로 같은 모양 */
  @supports not (scrollbar-color: auto) {
    ::-webkit-scrollbar {
      width: 10px;
      height: 10px;
    }
    ::-webkit-scrollbar-track {
      background: transparent;
    }
    ::-webkit-scrollbar-thumb {
      border: 3px solid transparent;
      border-radius: 999px;
      background: var(--scrollbar-thumb) padding-box;
    }
    ::-webkit-scrollbar-thumb:hover {
      background-color: var(--scrollbar-thumb-hover);
    }
  }
</style>
